# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli local state — containers, ports, and branch bookkeeping for this machine only
supabase/.temp/
supabase/.branches/

# vendored agent skills. Third-party code, restorable from skills-lock.json, so it is pinned
# rather than committed — same reasoning as node_modules.
.agents/

# symlinks into .agents/, which would be dangling in a fresh clone. .claude/commands/ is real
# tooling (OpenSpec) and stays tracked.
.claude/skills/
.claude/settings.local.json

# superpowers subagent-driven-development scratch: progress ledger, task briefs/reports, review
# packages. Local bookkeeping for one session's execution, not project state.
.superpowers/
